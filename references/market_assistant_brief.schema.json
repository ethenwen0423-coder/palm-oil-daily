{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Market assistant AI brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "headline",
    "market_state",
    "summary",
    "key_moves",
    "watchlist",
    "sector_views",
    "actions",
    "risks",
    "confidence"
  ],
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 4,
      "maxLength": 48
    },
    "market_state": {
      "type": "string",
      "enum": ["偏强", "震荡", "偏弱", "分化", "数据不足"]
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 220
    },
    "key_moves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "interpretation"],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "interpretation": {
            "type": "string",
            "minLength": 4,
            "maxLength": 100
          }
        }
      }
    },
    "watchlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "item", "trigger", "why", "evidence_ids"],
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["高", "中", "低"]
          },
          "item": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "trigger": {
            "type": "string",
            "enum": [
              "上破观察位",
              "下破观察位",
              "波动扩大",
              "数据恢复",
              "数据转为延迟",
              "报告更新",
              "官方数据更新"
            ]
          },
          "why": {
            "type": "string",
            "minLength": 4,
            "maxLength": 120
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            }
          }
        }
      }
    },
    "sector_views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sector", "state", "summary", "evidence_ids"],
        "properties": {
          "sector": {
            "type": "string",
            "minLength": 2,
            "maxLength": 20
          },
          "state": {
            "type": "string",
            "enum": ["偏强", "震荡", "偏弱", "分化", "数据不足"]
          },
          "summary": {
            "type": "string",
            "minLength": 4,
            "maxLength": 100
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "task", "result", "next_check"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["completed", "monitoring", "blocked"]
          },
          "task": {
            "type": "string",
            "minLength": 2,
            "maxLength": 70
          },
          "result": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "next_check": {
            "type": "string",
            "enum": [
              "下一次行情刷新",
              "下一次报告更新",
              "下一次官方数据检查",
              "数据恢复后",
              "持续监控"
            ]
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 120
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["高", "中", "低"]
    }
  }
}
